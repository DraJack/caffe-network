# ─────────────────────────────────────────────
# Caffè Network — variabili d'ambiente (esempio)
# Copia questo file in .env e in .env.local e compila i valori.
# NON committare .env / .env.local (sono ignorati da git).
# ─────────────────────────────────────────────

# Database PostgreSQL (Neon). Crea un progetto gratuito su https://neon.tech
# Usa la "pooled connection" per l'app e imposta anche DIRECT_URL per le migrazioni.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth v5). Genera con: npx auth secret
AUTH_SECRET="cambia-questo-segreto"
# In sviluppo:
AUTH_URL="http://localhost:3000"

# Stripe (TEST MODE). Dashboard: https://dashboard.stripe.com/test/apikeys
# Lasciando il placeholder il checkout gira in MODALITÀ DEMO (pagamento simulato).
STRIPE_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Ottenuto con `stripe listen` (Stripe CLI) o dal dashboard webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# URL pubblico del sito: link di invito, vetrine, metadata, sitemap e redirect Stripe.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Facoltativo: se diverso, usato solo per i redirect di Stripe Checkout.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protegge /api/cron/commissions (maturazione giornaliera). Genera con: openssl rand -hex 32
CRON_SECRET="cambia-questo-segreto"

# Email (Resend) — opzionale in dev, le email vengono loggate se assente
RESEND_API_KEY=""
EMAIL_FROM="Caffè Network <noreply@example.com>"
